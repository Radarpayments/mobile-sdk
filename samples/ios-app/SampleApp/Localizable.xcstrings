    "Pays an order with a saved card: its bindingId instead of card data.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدفع طلبًا ببطاقة محفوظة: bindingId الخاص بها بدلًا من بيانات البطاقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плащане на поръчка със запазена карта: нейният bindingId вместо данните за картата."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung einer Bestellung mit gespeicherter Karte: bindingId statt Kartendaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληρώνει μια παραγγελία με αποθηκευμένη κάρτα: το bindingId της αντί για τα στοιχεία κάρτας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga un pedido con una tarjeta guardada: su bindingId en lugar de los datos de la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paie une commande avec une carte enregistrée : son bindingId au lieu des données de la carte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plata unei comenzi cu un card salvat: bindingId-ul cardului în locul datelor acestuia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата заказа сохранённой картой: bindingId вместо данных карты."
          }
        }
      }
    },
    "Pays an order you registered: card data plus its mdOrder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدفع طلبًا سجّلته: بيانات البطاقة مع mdOrder الخاص به."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плащане на регистрирана от вас поръчка: данните за картата и нейният mdOrder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung einer registrierten Bestellung: Kartendaten plus deren mdOrder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληρώνει μια παραγγελία που καταχωρίσατε: στοιχεία κάρτας και το mdOrder της."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga un pedido que has registrado: datos de la tarjeta y su mdOrder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paie une commande déjà créée : données de la carte et son mdOrder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plata unei comenzi înregistrate de dvs.: datele cardului și mdOrder-ul comenzii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата зарегистрированного заказа: данные карты и его mdOrder."
          }
        }
      }
    },
