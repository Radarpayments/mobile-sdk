    "Stored only on this device. In your app the order is registered by your backend.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ على هذا الجهاز فقط. في تطبيقك، يسجّل الخادم الخلفي لديك الطلب."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съхраняват се само на това устройство. Във вашето приложение поръчката се регистрира от вашия бекенд."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem Gerät gespeichert. In Ihrer App legt Ihr Backend die Bestellung an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύονται μόνο σε αυτήν τη συσκευή. Στη δική σας εφαρμογή, την παραγγελία την καταχωρίζει το backend σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guardan en este dispositivo. En tu app, el pedido lo registra tu backend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockés uniquement sur cet appareil. Dans votre app, la commande est créée par votre backend."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se păstrează doar pe acest dispozitiv. În aplicația dvs., comanda este înregistrată de backend."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранятся только на этом устройстве. В вашем приложении заказ регистрирует ваш бэкенд."
