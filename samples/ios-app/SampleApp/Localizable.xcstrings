    "A ready payment sheet in your app — every store has all scenarios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واجهة دفع جاهزة داخل تطبيقك — كل متجر يتضمن جميع السيناريوهات"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Готов панел за плащане във вашето приложение — всеки магазин има всички сценарии"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein fertiges Zahlungsfenster für Ihre App — jeder Shop enthält alle Szenarien"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έτοιμο παράθυρο πληρωμής στην εφαρμογή σας — κάθε κατάστημα περιλαμβάνει όλα τα σενάρια"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel de pago listo en tu app — cada tienda incluye todos los escenarios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volet de paiement prêt à l’emploi dans votre app — chaque boutique propose tous les scénarios"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O fereastră de plată gata de folosit în aplicația dvs. — fiecare magazin include toate scenariile"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовая шторка оплаты в вашем приложении — в каждом магазине все сценарии"
          }
        }
      }
    },
