    "Orders are registered with register.do using the merchant login and password.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُسجَّل الطلبات عبر register.do باستخدام اسم مستخدم التاجر وكلمة المرور."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поръчките се регистрират чрез register.do с потребителското име и паролата на търговеца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestellungen werden über register.do mit Händler-Login und Passwort angelegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι παραγγελίες καταχωρίζονται μέσω register.do με το όνομα χρήστη και τον κωδικό του εμπόρου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pedidos se registran con register.do usando el usuario y la contraseña del comercio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes sont créées via register.do avec l’identifiant et le mot de passe marchand."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzile se înregistrează prin register.do cu loginul și parola comerciantului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказы регистрируются через register.do по логину и паролю мерчанта."
          }
        }
      }
    },
