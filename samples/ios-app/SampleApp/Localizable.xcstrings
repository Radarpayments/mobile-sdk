    "No order yet: your server creates it and pays in one call.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد طلب بعد: ينشئه خادمك ويدفعه في استدعاء واحد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още няма поръчка: сървърът ви я създава и я плаща с една заявка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Bestellung: Ihr Server legt sie an und bezahlt in einem Aufruf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμη παραγγελία: ο διακομιστής σας τη δημιουργεί και την πληρώνει με μία κλήση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay pedido: tu servidor lo crea y lo paga en una sola llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de commande : votre serveur la crée et la paie en un seul appel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există o comandă: serverul dvs. o creează și o plătește printr-un singur apel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказа ещё нет: сервер создаёт его и оплачивает одним запросом."
          }
        }
      }
    },
