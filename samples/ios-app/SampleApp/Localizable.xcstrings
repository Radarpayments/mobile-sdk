    "Transfers are registered with registerP2P.do (one-leg AFT): the sheet asks for the sender and recipient details.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُسجَّل التحويلات عبر registerP2P.do (AFT باتجاه واحد): تطلب النافذة بيانات المرسل والمستلم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преводите се регистрират чрез registerP2P.do (еднопосочен AFT): прозорецът иска данните на изпращача и получателя."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überweisungen werden über registerP2P.do angelegt (einseitiges AFT): Das Fenster fragt nach den Daten von Absender und Empfänger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι μεταφορές καταχωρίζονται μέσω registerP2P.do (AFT μίας κατεύθυνσης): το παράθυρο ζητά τα στοιχεία αποστολέα και παραλήπτη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias se registran con registerP2P.do (AFT de un solo sentido): la ventana pide los datos del remitente y del destinatario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transferts sont créés via registerP2P.do (AFT à sens unique) : la fenêtre demande les coordonnées de l’expéditeur et du destinataire."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferurile se înregistrează prin registerP2P.do (AFT într-un singur sens): fereastra cere datele expeditorului și ale destinatarului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы регистрируются через registerP2P.do (AFT в одну сторону): шторка попросит данные отправителя и получателя."
          }
        }
      }
    },
