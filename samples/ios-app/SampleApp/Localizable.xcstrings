    "Choose it in the payment sheet at your next top-up. No money was taken.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخترها في نافذة الدفع عند الشحن التالي. لم يُخصم أي مبلغ."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете я в прозореца за плащане при следващото захранване. Не е изтеглена сума."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie sie bei der nächsten Aufladung im Zahlungsfenster. Es wurde nichts abgebucht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε την στο παράθυρο πληρωμής στην επόμενη φόρτωση. Δεν χρεώθηκε κανένα ποσό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elígela en la ventana de pago en tu próxima recarga. No se ha cobrado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-la dans la fenêtre de paiement lors de votre prochaine alimentation. Aucun montant n'a été débité."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți-l în fereastra de plată la următoarea alimentare. Nu s-a retras nicio sumă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите её в окне оплаты при следующем пополнении. Деньги не списаны."
          }
        }
      }
    },
