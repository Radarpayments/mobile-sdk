# Per-frame Vision text recognition, kept in Objective-C (ARC).
#
# Vision objects created from Kotlin are released only when the Kotlin GC runs, and the image request
# handler holds the camera's pixel buffer until then: after a dozen frames the capture output runs out
# of buffers and the preview freezes until the next GC. Here every object that touches the frame is
# released when the function returns; only plain strings and numbers cross into Kotlin.
language = Objective-C
headers = Vision/Vision.h
compilerOpts = -fobjc-arc -fno-modules
linkerOpts = -framework Vision
---

/**
 * Text lines found in [sampleBuffer]: each item is [text, x, y, width, height], the box in Vision's
 * normalised coordinates (origin bottom-left). Empty when nothing is found or recognition fails.
 */
static inline NSArray *payrdr_recognize_text(CMSampleBufferRef sampleBuffer) {
    NSMutableArray *lines = [[NSMutableArray alloc] init];
    @autoreleasepool {
        VNRecognizeTextRequest *request = [[VNRecognizeTextRequest alloc] init];
        request.recognitionLevel = VNRequestTextRecognitionLevelAccurate;
        request.usesLanguageCorrection = NO;
        VNImageRequestHandler *handler = [[VNImageRequestHandler alloc] initWithCMSampleBuffer:sampleBuffer options:@{}];
        if ([handler performRequests:@[request] error:nil]) {
            for (VNRecognizedTextObservation *observation in request.results) {
                VNRecognizedText *best = [observation topCandidates:1].firstObject;
                if (best == nil) continue;
                CGRect box = observation.boundingBox;
                [lines addObject:@[best.string, @(box.origin.x), @(box.origin.y), @(box.size.width), @(box.size.height)]];
            }
        }
    }
    return lines;
}
