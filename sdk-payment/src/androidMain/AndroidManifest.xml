<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required: the SDK makes HTTPS calls to the payment gateway (key provider, process form,
         finish 3DS, etc.). Merged into the consumer app's manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <activity
            android:name="net.payrdr.mobile.payment.sdk.payment.android.SdkPaymentActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="net.payrdr.mobile.payment.sdk.payment.android.ThreeDsWebActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
